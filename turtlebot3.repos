# Upstream ROBOTIS repositories used by this workspace, pinned to the
# commits this project was developed and tested with (humble branches).
#
# Import into src/ with:
#   vcs import src < turtlebot3.repos
repositories:
  turtlebot3:
    type: git
    url: https://github.com/ROBOTIS-GIT/turtlebot3.git
    version: 90a68bd2e3c61c12966779da89d8eeaec82730e9
  turtlebot3_msgs:
    type: git
    url: https://github.com/ROBOTIS-GIT/turtlebot3_msgs.git
    version: cdee60f7618b9ed2f85f65259c0f96e3f02b1c55
  turtlebot3_simulations:
    type: git
    url: https://github.com/ROBOTIS-GIT/turtlebot3_simulations.git
    version: a35a56c8b04877dc89772b598084d8ce648a9023
  DynamixelSDK:
    type: git
    url: https://github.com/ROBOTIS-GIT/DynamixelSDK.git
    version: 59abd67d1f16a199cf0c8608231aee6bb63a57f3
